---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { assertLocale } from '../../i18n/locales';
import { localePaths } from '../../i18n/paths';
import { useTranslations } from '../../i18n/ui';
import { getPage } from '../../lib/content';

export function getStaticPaths() {
  return localePaths();
}

const locale = assertLocale(Astro.params.lang);
const t = useTranslations(locale);

// Throws, naming the file, if this language's page is missing.
const about = await getPage(locale, 'about');
const { Content } = await render(about);
---

<Base locale={locale} routeKey="about" title={t('nav.about')} description={about.data.description}>
  <h1>{about.data.title}</h1>
  <div class="prose about">
    <Content />
  </div>
</Base>

<style>
  .about {
    margin-top: var(--space-m);
  }
</style>
