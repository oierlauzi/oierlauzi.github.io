---
import type { Locale } from '../i18n/locales';
import type { Localized, Period } from '../content/schema';
import { formatPeriod } from '../lib/dates';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  name: string;
  summary: Localized<string>;
  period?: Period | undefined;
  status: 'active' | 'in-development' | 'archived';
  tech?: string[];
  primaryUrl?: string | undefined;
  components?: { name: string; url: string; summary: Localized<string> }[];
  ongoingLabel: string;
}

const {
  locale,
  name,
  summary,
  period,
  status,
  tech = [],
  primaryUrl,
  components = [],
  ongoingLabel,
} = Astro.props;

const t = useTranslations(locale);

const statusLabel =
  status === 'archived'
    ? t('status.archived')
    : status === 'in-development'
      ? t('status.inDevelopment')
      : null;
---

<article class="project">
  <header class="project__head">
    <h3 class="project__name">
      {primaryUrl ? <a href={primaryUrl}>{name}</a> : name}
    </h3>
    <p class="project__when meta">
      {period && formatPeriod(period, locale, ongoingLabel)}
      {statusLabel && <span class="project__status">{statusLabel}</span>}
    </p>
  </header>

  <p class="project__summary">{summary[locale]}</p>

  {tech.length > 0 && <p class="project__tech meta">{tech.join(' · ')}</p>}

  {
    components.length > 0 && (
      <ul class="project__components">
        {components.map((c) => (
          <li>
            <a href={c.url} class="project__component-name">
              {c.name}
            </a>
            <span class="meta"> — {c.summary[locale]}</span>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .project {
    break-inside: avoid;
  }

  .project + .project {
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .project__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-m);
  }

  .project__name {
    font-size: var(--step-0);
    font-weight: 600;
    min-width: 0;
  }

  .project__when {
    white-space: nowrap;
    display: flex;
    gap: var(--space-xs);
  }

  .project__status {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 0.05em 0.45em;
  }

  .project__summary {
    margin-top: 0.15em;
    max-width: var(--measure);
  }

  .project__tech {
    margin-top: var(--space-2xs);
  }

  .project__components {
    margin-top: var(--space-xs);
    padding-left: 0;
    list-style: none;
    border-left: 1px solid var(--rule);
  }

  .project__components li {
    padding-left: var(--space-s);
    font-size: var(--step--1);
  }

  .project__component-name {
    font-family: var(--sans);
  }
</style>
