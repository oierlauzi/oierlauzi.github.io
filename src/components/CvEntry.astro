---
import { LOCALE_META, type Locale } from '../i18n/locales';
import type { Honours, Localized, Period } from '../content/schema';
import { formatPeriod } from '../lib/dates';

interface Props {
  locale: Locale;
  title: Localized<string>;
  organisation: string;
  unit?: string | undefined;
  location?: string | undefined;
  period: Period;
  distinctions?: Localized<string>[];
  bullets?: Localized<string>[];
  honours?: Honours | undefined;
  /** `cv.honours`, with {credits} and {total} still to fill in. */
  honoursLabel?: string | undefined;
  url?: string | undefined;
  ongoingLabel: string;
  /** False drops the whole entry from the PDF, keeping it on the web. */
  inPdf?: boolean;
  /** Cap on bullets in the PDF; omit for all of them. */
  pdfBullets?: number | undefined;
}

const {
  locale,
  title,
  organisation,
  unit,
  location,
  period,
  distinctions = [],
  bullets = [],
  honours,
  honoursLabel,
  url,
  ongoingLabel,
  inPdf = true,
  pdfBullets,
} = Astro.props;

const affiliation = [unit, organisation].filter(Boolean).join(', ');

// Credits come from the list itself, so the headline figure and the subjects
// behind it cannot disagree. Intl because the decimal separator differs: 97.5
// in English, 97,5 in Spanish and Basque.
const credits = new Intl.NumberFormat(LOCALE_META[locale].intlTag);
const honoursTally =
  honours && honoursLabel
    ? honoursLabel
        .replace('{credits}', credits.format(honours.subjects.reduce((n, s) => n + s.credits, 0)))
        .replace('{total}', credits.format(honours.totalCredits))
    : null;

// A per-entry bullet cap cannot be expressed in CSS alone — :nth-child() cannot
// read a custom property — so the surplus is marked here and print.css hides it.
const bulletHidden = (index: number) => pdfBullets !== undefined && index >= pdfBullets;
---

<article class:list={['entry', { 'print-hide': !inPdf }]}>
  <header class="entry__head">
    <h3 class="entry__title">
      {url ? <a href={url}>{title[locale]}</a> : title[locale]}
    </h3>
    <p class="entry__when meta">{formatPeriod(period, locale, ongoingLabel)}</p>
  </header>

  <p class="entry__where meta">
    {affiliation}{location && <span class="entry__location"> · {location}</span>}
  </p>

  {
    distinctions.length > 0 && (
      <ul class="entry__distinctions">
        {distinctions.map((d) => (
          <li>{d[locale]}</li>
        ))}
      </ul>
    )
  }

  {
    honours && honoursTally && (
      <details class="entry__honours">
        {/* Collapsed by default, and print.css keeps only the summary line: a
            CV entry should not open onto seventeen course titles. */}
        <summary>{honoursTally}</summary>
        <ul>
          {honours.subjects.map((s) => (
            <li>
              {s.name} ({credits.format(s.credits)} ECTS)
            </li>
          ))}
        </ul>
      </details>
    )
  }

  {
    bullets.length > 0 && (
      <ul class="entry__bullets">
        {bullets.map((b, i) => (
          <li class:list={{ 'print-hide': bulletHidden(i) }}>{b[locale]}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .entry {
    /* An entry should not be split across a page break in the PDF. */
    break-inside: avoid;
  }

  .entry + .entry {
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  /*
   * No flex-wrap: a long title should wrap its own text and leave the date in
   * the top-right corner, rather than pushing the date onto a new line where
   * it reads as a stray value. Several Basque titles are long enough to hit
   * this ("Informatika eta Telekomunikazio Ingeniaritzako Doktoretza Programa").
   */
  .entry__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-m);
  }

  .entry__title {
    font-size: var(--step-0);
    font-weight: 600;
    min-width: 0;
  }

  .entry__when {
    white-space: nowrap;
  }

  .entry__where {
    margin-top: 0.1em;
  }

  .entry__distinctions,
  .entry__bullets {
    margin-top: var(--space-xs);
    padding-left: 1.1em;
  }

  .entry__distinctions {
    list-style: none;
    padding-left: 0;
  }

  .entry__distinctions li {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .entry__distinctions li::before {
    content: '—';
    color: var(--muted);
    margin-right: 0.5em;
  }

  .entry__bullets li {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /*
   * The disclosure triangle is this line's marker on screen, where the em dash
   * of a distinction would say "fact" rather than "there is more here". In the
   * PDF, where nothing is clickable, print.css swaps it back for the dash so
   * the line matches its siblings.
   */
  .entry__honours {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .entry__honours summary {
    cursor: pointer;
  }

  .entry__honours summary:hover {
    color: var(--ink);
  }

  .entry__honours ul {
    margin-top: 0.4em;
    padding-left: 1.2em;
  }

  /* Seventeen titles are a long scroll in one column. */
  @media (min-width: 40rem) {
    .entry__honours ul {
      columns: 2;
      column-gap: var(--space-l);
    }
  }

  .entry__honours li {
    break-inside: avoid;
  }
</style>
