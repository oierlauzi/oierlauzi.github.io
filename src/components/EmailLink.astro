---
import { PERSON } from '../site';

const { user, domain } = PERSON.email;
---

{/*
  The address is never emitted as a single string. A script joins the two parts
  into a real mailto: link; without JavaScript the visible "user [at] domain"
  remains readable. Light cover against naive harvesters, not real protection.
*/}
<span class="email" data-user={user} data-domain={domain}>{user} [at] {domain}</span>

<script is:inline>
  (function () {
    var nodes = document.querySelectorAll('.email[data-user][data-domain]');
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      var address = el.getAttribute('data-user') + '@' + el.getAttribute('data-domain');
      var link = document.createElement('a');
      link.href = 'mailto:' + address;
      link.textContent = address;
      el.replaceWith(link);
    }
  })();
</script>
