---
interface Props {
  title: string;
  /** Rendered as the section's heading id, for in-page links. */
  id?: string;
}

const { title, id } = Astro.props;
---

<section class="cv-section" id={id}>
  <h2 class="section-label">{title}</h2>
  <slot />
</section>

<style>
  .cv-section {
    /* Keeps a heading from being orphaned at the foot of a printed page. */
    break-inside: auto;
  }

  .cv-section :global(.section-label) {
    break-after: avoid;
  }
</style>
